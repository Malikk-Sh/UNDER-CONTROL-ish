{
  "name": "@uc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Авторитетный игровой сервер на Colyseus",
  "//": "--tsconfig обязателен: без него tsx может подобрать конфиг без useDefineForClassFields:false, и поля @colyseus/schema перестанут отслеживать изменения.",
