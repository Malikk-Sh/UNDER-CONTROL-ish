    "dev": "tsx watch --tsconfig ./tsconfig.json src/index.ts",
    "start": "tsx --tsconfig ./tsconfig.json src/index.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@uc/shared": "*",
    "colyseus": "^0.16.5",
    "express": "^4.21.2",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21"
  }
}
